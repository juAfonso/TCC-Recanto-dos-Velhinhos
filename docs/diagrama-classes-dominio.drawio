        <mxCell id="dominio_m39" value="0..1" style="edgeLabel;resizable=0;html=1;align=left;verticalAlign=bottom;fontSize=11;labelBackgroundColor=none;fontColor=#2C2C2A;" vertex="1" connectable="0" parent="dominio_e38"><mxGeometry x="-1" relative="1" as="geometry"><mxPoint x="5" y="-2" as="offset"/></mxGeometry></mxCell>
