# Modelo das variáveis de ambiente (quickstart.md → "Variáveis de ambiente").
# Copie para .env.local e preencha. O .env.local NUNCA vai para o Git.
# Na Vercel, os mesmos nomes são cadastrados em Settings → Environment Variables.

# Neon — produção/desenvolvimento (criada pela integração Vercel ↔ Neon, prefixo DATABASE)
DATABASE_URL=
# Neon — branch "teste", usada por node --test
DATABASE_URL_TESTE=
# Neon — branch main (PRODUÇÃO). Só para npm run migrate/seed -- --producao. Deixe vazia se não for você quem cuida da produção.
DATABASE_URL_PRODUCAO=

# Vercel Blob — dois stores, porque o acesso é escolhido ao criar o store (research D3).
# Privado: currículos. Sem ele, a candidatura aceita só o texto.
BLOB_PRIVADO_READ_WRITE_TOKEN=
# Público: imagens das notícias e da página institucional (fase 11).
BLOB_PUBLICO_READ_WRITE_TOKEN=

# HMAC do cookie de sessão (32+ bytes aleatórios)
SESSION_SECRET=
# Protege /api/cron/diario
CRON_SECRET=

# Gmail INSTITUCIONAL (nunca pessoal) e senha de aplicativo — research D5
GMAIL_USER=
GMAIL_APP_PASSWORD=

# Base dos links de senha enviados por e-mail
APP_URL=

# Só no desenvolvimento: "console" mostra os e-mails no terminal do npm run dev em vez de enviar.
# Na Vercel, NÃO definir (os e-mails saem pelo Gmail).
EMAIL_MODO=
