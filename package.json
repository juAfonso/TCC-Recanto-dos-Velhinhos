{
  "name": "sage-recanto-dos-velhinhos",
  "version": "0.1.0",
  "private": true,
  "description": "SAGE — Portal Público e Painel Administrativo do Recanto dos Velhinhos Francisco Gonçalves Barbosa",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env.local scripts/dev.js",
    "migrate": "node --env-file-if-exists=.env.local db/migrate.js",
    "seed": "node --env-file-if-exists=.env.local db/seed.js",
    "test": "node --env-file-if-exists=.env.local --test --test-concurrency=1 \"tests/**/*.test.js\""
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.2.0",
    "@vercel/blob": "^2.8.1",
    "nodemailer": "^10.0.15"
  }
}
