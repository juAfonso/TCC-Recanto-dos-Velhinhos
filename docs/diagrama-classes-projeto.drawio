        <mxCell id="projeto_entidades_m48" value="0..*" style="edgeLabel;resizable=0;html=1;align=left;verticalAlign=bottom;fontSize=11;labelBackgroundColor=none;fontColor=#2C2C2A;" vertex="1" connectable="0" parent="projeto_entidades_e46"><mxGeometry x="1" relative="1" as="geometry"><mxPoint x="5" y="-2" as="offset"/></mxGeometry></mxCell>
        <mxCell id="n1" value="&lt;b&gt;Identificadores e autoria&lt;/b&gt; — chaves UUID (gen_random_uuid), exceto RegistroAuditoria (bigserial). Toda tabela de negócio guarda autor e data na própria linha (*Por/*Em): conta institucional, doador, &quot;publico&quot; ou &quot;sistema&quot; — nunca o funcionário individual (FR-035)." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=8;fillColor=#FFF9DB;strokeColor=#B59F3B;fontColor=#3D3410;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1321" y="120" width="424" height="110" as="geometry"/></mxCell>
        <mxCell id="n5" value="&lt;b&gt;Consentimento — Restrição 4 do DER&lt;/b&gt;: quatro FKs opcionais (cadastro_voluntario, candidatura, solicitacao_externa, pessoa) e um CHECK de que exatamente uma está preenchida. O doador tem um consentimento por versão do aviso aceita." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=8;fillColor=#FFF9DB;strokeColor=#B59F3B;fontColor=#3D3410;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1321" y="250" width="424" height="110" as="geometry"/></mxCell>
        <mxCell id="n2" value="&lt;b&gt;Sem exclusão física&lt;/b&gt; (Princípio III) — nenhuma rota faz DELETE em tabela de negócio. Remover é mudar status ou desativar (ativo = false). Anonimizar troca os campos pessoais por &quot;[anonimizado]&quot; e preenche anonimizadoEm, mantendo a linha (FR-055)." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=8;fillColor=#FFF9DB;strokeColor=#B59F3B;fontColor=#3D3410;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1855" y="120" width="298" height="110" as="geometry"/></mxCell>
        <mxCell id="n6" value="&lt;b&gt;SubmissaoTriada&lt;/b&gt; não vira tabela: seus atributos se repetem em cadastro_voluntario, candidatura e solicitacao_externa, e o módulo api/_lib/triagem.js aplica as transições das três (Princípio VIII: nenhuma aprovação automática)." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=8;fillColor=#FFF9DB;strokeColor=#B59F3B;fontColor=#3D3410;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1855" y="250" width="298" height="110" as="geometry"/></mxCell>
        <mxCell id="n3" value="&lt;b&gt;Doacao&lt;/b&gt; — não é editável (FR-037). confirmar() só age sobre status = pendente (UPDATE … WHERE status = &quot;pendente&quot;), o que impede confirmação dupla (FR-050). Nada no sistema confirma doação sem ação humana (Princípio VII)." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=8;fillColor=#FFF9DB;strokeColor=#B59F3B;fontColor=#3D3410;fontSize=11;" vertex="1" parent="1"><mxGeometry x="2263" y="120" width="550" height="110" as="geometry"/></mxCell>
        <mxCell id="n4" value="&lt;b&gt;Papel&lt;/b&gt; — índice único parcial impede funcionario e voluntario ativos na mesma Pessoa (FR-048, D14). Efetivar uma candidatura encerra o papel de voluntário na mesma transação." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=8;fillColor=#FFF9DB;strokeColor=#B59F3B;fontColor=#3D3410;fontSize=11;" vertex="1" parent="1"><mxGeometry x="2263" y="250" width="550" height="110" as="geometry"/></mxCell>
