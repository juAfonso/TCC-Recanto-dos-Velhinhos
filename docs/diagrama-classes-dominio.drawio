        <mxCell id="dominio_e41" value="Aceite_Doador" style="html=1;rounded=0;fontSize=11;labelBackgroundColor=#FFFFFF;fontColor=#2C2C2A;strokeColor=#3A3A38;endArrow=none;edgeStyle=orthogonalEdgeStyle;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=0.7;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="doador" target="consentimento"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1073.7" y="652.5"/></Array></mxGeometry></mxCell>
        <mxCell id="dominio_m42" value="0..1" style="edgeLabel;resizable=0;html=1;align=right;verticalAlign=bottom;fontSize=11;labelBackgroundColor=none;fontColor=#2C2C2A;" vertex="1" connectable="0" parent="dominio_e41"><mxGeometry x="-1" relative="1" as="geometry"><mxPoint x="-5" y="-2" as="offset"/></mxGeometry></mxCell>
        <mxCell id="dominio_m43" value="1..*" style="edgeLabel;resizable=0;html=1;align=left;verticalAlign=top;fontSize=11;labelBackgroundColor=none;fontColor=#2C2C2A;" vertex="1" connectable="0" parent="dominio_e41"><mxGeometry x="1" relative="1" as="geometry"><mxPoint x="5" y="3" as="offset"/></mxGeometry></mxCell>
        <mxCell id="xor" value="{xor}" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#2C2C2A;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="1001.3" y="233" width="50" height="20" as="geometry"/></mxCell>
        <mxCell id="n_r1" value="&lt;b&gt;Restrição 1&lt;/b&gt; — toda Pessoa tem pelo menos um papel (Funcionario, Voluntario ou DoadorAssociado). Vale para a união das duas especializações, cada uma parcial." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=8;fillColor=#FFF9DB;strokeColor=#B59F3B;fontColor=#3D3410;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1840" y="353" width="330" height="80" as="geometry"/></mxCell>
        <mxCell id="n_r2" value="&lt;b&gt;Restrição 2&lt;/b&gt; — Funcionario e Voluntario são papéis exclusivos. Na Efetivação de quem já é voluntário, o papel de voluntário é encerrado, nunca apagado (FR-048). DoadorAssociado acumula com qualquer um." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=8;fillColor=#FFF9DB;strokeColor=#B59F3B;fontColor=#3D3410;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1840" y="453" width="330" height="96" as="geometry"/></mxCell>
        <mxCell id="n_r3" value="&lt;b&gt;Restrição 3&lt;/b&gt; — doação espontânea não tem DoadorAssociado. Toda Doacao nasce pendente; só a conferência humana no extrato a torna confirmada (Princípio VII)." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=8;fillColor=#FFF9DB;strokeColor=#B59F3B;fontColor=#3D3410;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1840" y="569" width="330" height="82" as="geometry"/></mxCell>
        <mxCell id="n_r4" value="&lt;b&gt;Restrição 4&lt;/b&gt; — todo Consentimento pertence a exatamente um dono: Candidato, Solicitacao ou DoadorAssociado. O doador tem um consentimento por versão do aviso aceita." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=8;fillColor=#FFF9DB;strokeColor=#B59F3B;fontColor=#3D3410;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1840" y="671" width="330" height="82" as="geometry"/></mxCell>
        <mxCell id="n_r5" value="&lt;b&gt;Preservação&lt;/b&gt; — nenhuma classe é excluída fisicamente: usa-se situação (ativo, inativo, encerrado, despublicada). Dado pessoal só deixa de existir por anonimização (FR-055, FR-056)." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=8;fillColor=#FFF9DB;strokeColor=#B59F3B;fontColor=#3D3410;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1840" y="773" width="330" height="82" as="geometry"/></mxCell>
        <mxCell id="n_r6" value="&lt;b&gt;Endereco&lt;/b&gt; agrupa logradouro, bairro, CEP, cidade e UF. &lt;b&gt;Arquivo&lt;/b&gt; é o documento guardado no Vercel Blob (currículo ou imagem)." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=8;fillColor=#FFF9DB;strokeColor=#B59F3B;fontColor=#3D3410;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1840" y="875" width="330" height="66" as="geometry"/></mxCell>
        <mxCell id="n_r7" value="Uma única chave Pix ativa por vez. Sem chave ativa, o Portal não oferece doação (FR-007a)." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=8;fillColor=#FFF9DB;strokeColor=#B59F3B;fontColor=#3D3410;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1540" y="486" width="165" height="52" as="geometry"/></mxCell>
